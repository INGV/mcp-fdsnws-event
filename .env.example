# Environment for the FDSNWS Event MCP server, with every value at its default.
#
#   cp .env.example .env        # then edit, .env is gitignored
#   docker run -i --rm --env-file .env ingv/mcp-fdsnws-event
#
# The MAX_ROWS_* values are read once at startup and are published as the
# maximum of each tool's limit parameter in the tools/list schema, so a change
# needs a restart -- and a refresh of any client that caches that schema,
# OpenWebUI included.
# A value that is not a positive integer falls back to the default with a
# warning; a DEFAULT_ above its own MAX_ is clamped down rather than fatal.
#
# The numbers below are calibrated for a 32k context window at the measured
# density of this JSON, 1.87 bytes per token. A larger window is exactly what
# these variables are here to be raised for.

# Timeout of a request to the datacenter, in seconds. Read per call.
FDSN_TIMEOUT=45

# Byte budget for a single tool result (~19250 tokens, 59% of a 32k window):
# a table over it is trimmed to fewer rows, a non-splittable object over it is
# refused with a structured error.
FDSN_MAX_RESULT_BYTES=36000

# Largest limit accepted by fdsn_get_arrivals_by_eventid.
FDSN_MAX_ROWS_ARRIVALS=90
# Limit used when the caller asks for none.
FDSN_DEFAULT_ROWS_ARRIVALS=90

# Largest limit accepted by fdsn_get_stationmagnitudes_by_eventid.
FDSN_MAX_ROWS_STATIONMAGNITUDES=220
# Limit used when the caller asks for none.
FDSN_DEFAULT_ROWS_STATIONMAGNITUDES=200

# Largest limit accepted by fdsn_get_amplitudes_by_eventid.
FDSN_MAX_ROWS_AMPLITUDES=125
# Limit used when the caller asks for none.
FDSN_DEFAULT_ROWS_AMPLITUDES=125

# Largest limit accepted by fdsn_query_earthquakes.
FDSN_MAX_ROWS_EVENTS=240
# Limit used when the caller asks for none.
FDSN_DEFAULT_ROWS_EVENTS=100
